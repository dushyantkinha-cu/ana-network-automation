      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ana-lab-influx"
          },
          "query": "from(bucket: \"ana-lab\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"net_neighbor_state\")\n  |> filter(fn: (r) => r._field == \"session_up\")\n  |> filter(fn: (r) => r.device != \"R5\")\n  |> group(columns: [\"device\", \"protocol\", \"neighbor\", \"interface\"])\n  |> last()\n  |> map(fn: (r) => ({r with _value: if r._value == 1 then 0 else 1}))\n  |> group()\n  |> sum(column: \"_value\")"
        }
      ]
    },
