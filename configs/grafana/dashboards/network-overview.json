    {
      "id": 1,
      "type": "stat",
      "title": "Monitored Devices",
      "datasource": {
        "type": "influxdb",
        "uid": "ana-lab-influx"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ana-lab-influx"
          },
          "query": "from(bucket: \"ana-lab\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"net_device_health\")\n  |> filter(fn: (r) => r._field == \"cpu_util_pct\")\n  |> filter(fn: (r) => r.device != \"R5\")\n  |> group(columns: [\"device\"])\n  |> last()\n  |> group()\n  |> count(column: \"_value\")"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Admin-Up / Oper-Down Interfaces",
      "datasource": {
        "type": "influxdb",
        "uid": "ana-lab-influx"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ana-lab-influx"
          },
          "query": "\nfrom(bucket: \"ana-lab\")\n  |> range(start: -5m)\n  |> filter(fn: (r) =>\n    r._measurement == \"net_ifstate\"\n  )\n  |> filter(fn: (r) =>\n    r.device != \"R5\"\n  )\n  |> filter(fn: (r) =>\n    r._field == \"admin_status\" or\n    r._field == \"oper_status\"\n  )\n  |> group(columns: [\n    \"device\",\n    \"interface\",\n    \"_field\"\n  ])\n  |> last()\n  |> group()\n  |> pivot(\n    rowKey: [\"device\", \"interface\"],\n    columnKey: [\"_field\"],\n    valueColumn: \"_value\"\n  )\n  |> reduce(\n    identity: {interfaces_down: 0},\n    fn: (r, accumulator) => ({\n      interfaces_down:\n        accumulator.interfaces_down +\n        (if exists r.admin_status and\n            exists r.oper_status and\n            r.admin_status == \"UP\" and\n            r.oper_status != \"UP\"\n         then 1\n         else 0)\n    })\n  )\n"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unhealthy Routing Neighbors",
      "datasource": {
        "type": "influxdb",
        "uid": "ana-lab-influx"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
