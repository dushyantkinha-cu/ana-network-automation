      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ana-lab-influx"
          },
          "query": "\nfrom(bucket: \"ana-lab\")\n  |> range(start: -5m)\n  |> filter(fn: (r) =>\n    r._measurement == \"net_device_health\"\n  )\n  |> filter(fn: (r) =>\n    r.device != \"R5\"\n  )\n  |> filter(fn: (r) =>\n    r._field == \"cpu_util_pct\" or\n    r._field == \"memory_util_pct\" or\n    r._field == \"uptime_seconds\"\n  )\n  |> group(columns: [\n    \"device\",\n    \"vendor\",\n    \"mgmt_ip\",\n    \"_field\"\n  ])\n  |> last()\n  |> map(fn: (r) => ({\n    r with\n    _value: float(v: r._value)\n  }))\n  |> group()\n  |> pivot(\n    rowKey: [\n      \"device\",\n      \"vendor\",\n      \"mgmt_ip\"\n    ],\n    columnKey: [\"_field\"],\n    valueColumn: \"_value\"\n  )\n  |> map(fn: (r) => ({\n    r with\n    uptime:\n      string(v: int(v: r.uptime_seconds) / 86400) + \"d \" +\n      string(v: (int(v: r.uptime_seconds) % 86400) / 3600) + \"h \" +\n      string(v: (int(v: r.uptime_seconds) % 3600) / 60) + \"m\"\n  }))\n  |> keep(columns: [\n    \"device\",\n    \"vendor\",\n    \"mgmt_ip\",\n    \"cpu_util_pct\",\n    \"memory_util_pct\",\n    \"uptime\"\n  ])\n  |> rename(columns: {\n    device: \"Device\",\n    vendor: \"Vendor\",\n    mgmt_ip: \"Management IP\",\n    cpu_util_pct: \"CPU %\",\n    memory_util_pct: \"Memory %\",\n    uptime: \"Uptime\"\n  })\n  |> sort(columns: [\"Device\"])\n"
        }
      ]
    },
