    {
      "id": 1,
      "type": "stat",
      "title": "Routing Adjacencies in Selection",
      "description": "Current BGP sessions, OSPFv2 adjacencies, OSPFv3 adjacencies, and IS-IS adjacencies matching the selectors.",
      "datasource": {
        "type": "influxdb",
        "uid": "ana-lab-influx"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ana-lab-influx"
          },
          "query": "\nfrom(bucket: \"ana-lab\")\n  |> range(start: -2m)\n  |> filter(fn: (r) =>\n    r._measurement == \"net_neighbor_state\"\n  )\n  |> filter(fn: (r) =>\n    r._field == \"session_up\"\n  )\n  |> filter(fn: (r) =>\n    r.device != \"R5\"\n  )\n  |> filter(fn: (r) =>\n    r.device =~ /^${device:regex}$/\n  )\n  |> filter(fn: (r) =>\n    r.protocol =~ /^${protocol:regex}$/\n  )\n  |> filter(fn: (r) =>\n    r.neighbor =~ /^${neighbor:regex}$/\n  )\n  |> group(columns: [\n    \"device\",\n    \"protocol\",\n    \"neighbor\",\n    \"interface\"\n  ])\n  |> last()\n  |> group()\n  |> reduce(\n    identity: {adjacencies: 0},\n    fn: (r, accumulator) => ({\n      adjacencies: accumulator.adjacencies + 1\n    })\n  )\n"
        }
      ]
    },
